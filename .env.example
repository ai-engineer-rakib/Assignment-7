# --- Better Auth ---
BETTER_AUTH_SECRET=put-a-long-random-string-here
# Local: http://localhost:3000   | Production: your vercel url (https://xxxx.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# --- MongoDB (MongoDB Atlas free cluster) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bazardor

# --- Social login (optional but recommended) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Bazar API (optional override) ---
BAZAR_API_1=https://openapi.programming-hero.com/api/bazardor
BAZAR_API_2=http://openapi.programming-hero.com/api/bazardor
